# ==========================================
# 1. TELEGRAM BOT & WEBHOOKS
# ==========================================
BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here
BOT_USERNAME=GhostVPN_Bot
WEBHOOK_BASE_URL=https://ghostvpn-bot.onrender.com
WEBHOOK_SECRET=replace_with_random_32_char_secret_token
SUPPORT_URL=https://t.me/ghostvpn_support
TERMS_URL=https://telegra.ph/Terms-of-Service-GhostVPN-01-01

# Список Telegram ID администраторов через запятую
ADMIN_IDS=123456789,987654321
# ID закрытого чата/группы для алертов об оплатах и сбоях (или ваш личный Telegram ID)
ADMIN_CHAT_ID=-1001234567890

# ==========================================
# 2. TRIAL & CHANNEL SUBSCRIPTION CHECK
# ==========================================
# Оставьте пустым, если не нужно требовать подписку на канал перед триалом
REQUIRED_CHANNEL_ID=-1009876543210
REQUIRED_CHANNEL_URL=https://t.me/ghostvpn_news
TRIAL_DAYS=3
DEFAULT_LIMIT_IP=3
KEY_RESET_COOLDOWN_HOURS=24

# ==========================================
# 3. CLOUD POSTGRESQL (NEON / SUPABASE)
# ==========================================
# Поддерживается как postgresql://, так и postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-cloud-123456.eu-central-1.aws.neon.tech/neondb?ssl=require

# ==========================================
# 4. 3X-UI PANEL (v3.11.0, VLESS + Reality)
# ==========================================
XUI_HOST=https://203.0.113.10:2053
XUI_WEB_BASE_PATH=/secret_base_path
XUI_USERNAME=admin
XUI_PASSWORD=strong_panel_password
XUI_INBOUND_ID=1
XUI_SUB_BASE_URL=https://203.0.113.10:2096/sub
XUI_VERIFY_SSL=True
XUI_SERVER_NAME="🇳🇱 Нидерланды (VLESS Reality)"

# ==========================================
# 5. PAYMENTS & REFERRALS
# ==========================================
REFERRAL_PERCENT=15
STARS_RUB_RATE=1.8

# CryptoBot (@send -> Crypto Pay -> Create App)
CRYPTOBOT_API_TOKEN=12345:AA_your_cryptopay_api_token
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
CRYPTOBOT_FIAT_CURRENCY=RUB

# Рублёвый шлюз (YooKassa / Platega stub)
RUB_GATEWAY_SHOP_ID=
RUB_GATEWAY_SECRET_KEY=
RUB_GATEWAY_WEBHOOK_SECRET=replace_with_rub_gateway_webhook_secret

# ==========================================
# 6. RUNTIME
# ==========================================
PORT=8000
LOG_LEVEL=INFO
